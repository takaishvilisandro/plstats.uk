# ==================================================

# ENABLE REWRITE

# ==================================================

RewriteEngine On

# ==================================================

# 1. FORCE HTTPS + NON-WWW (production host only)

# Apache cannot read PHP APP_ENV. These rules apply only when the
# request Host is plstats.uk / www.plstats.uk so localhost is unaffected.

# ==================================================

RewriteCond %{HTTP_HOST} ^(www\.)?plstats\.uk$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://plstats.uk%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.plstats\.uk$ [NC]
RewriteRule ^ https://plstats.uk%{REQUEST_URI} [R=301,L]

RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ==================================================

# 2. MATCH DETAIL WITH SEO SLUG

# Pattern: /matches/YYYY-YYYY/RR/team1-vs-team2/

# ==================================================

RewriteRule ^matches/([0-9]{4}-[0-9]{4})/([0-9]+)/([a-z0-9-]+)-vs-([a-z0-9-]+)/?$ matches/match.php?season=$1&round=$2&home=$3&away=$4 [L,QSA]

# ==================================================

# 3. MATCHES SEASON ARCHIVE

# ==================================================

RewriteRule ^matches/([0-9]{4}-[0-9]{4})/?$ matches/season.php?season=$1 [L,QSA]

# ==================================================

# 4. MATCHES HUB

# ==================================================

RewriteRule ^matches/?$ matches/index.php [L]

RewriteRule ^author/?$ author/index.php [L]

# ==================================================

# 5. TEAM DETAIL WITH SLUG

# ==================================================

RewriteRule ^teams/([a-z0-9-]+)/?$ teams/team.php?slug=$1 [L,QSA]

# ==================================================

# 6. TEAMS HUB

# ==================================================

RewriteRule ^teams/?$ teams/index.php [L]

# ==================================================

# 6b. LEAGUE TABLE

# /table/ = current season, /table/YYYY-YYYY/ = past season.
# /premier-league/table/ was live briefly: table/index.php 301s it to /table/.

# ==================================================

RewriteRule ^table/([0-9]{4}-[0-9]{4})/?$ table/index.php?season=$1 [L,QSA]
RewriteRule ^table/?$ table/index.php [L]
RewriteRule ^premier-league/table/?$ table/index.php [L]

# ==================================================

# 6c. PLAYER PROFILE WITH SLUG + PLAYERS DIRECTORY

# ==================================================

RewriteRule ^players/([a-z0-9-]+)/?$ players/player.php?slug=$1 [L,QSA]
RewriteRule ^players/?$ players/index.php [L]

# ==================================================

# 7. NEWS DETAIL (only when the script exists)

# ==================================================

RewriteCond news/news_details.php -f
RewriteRule ^news/([a-z0-9-]+)/?$ news/news_details.php?slug=$1 [L,QSA]

# ==================================================

# 8. NEWS HUB (only when the script exists)

# ==================================================

RewriteCond news/index.php -f
RewriteRule ^news/?$ news/index.php [L]

# ==================================================

# 9. CUSTOM 404

# Relative rewrite target resolves against this .htaccess directory, so the
# same rule works at document root (production) and under a subdirectory
# (local). Do not use ErrorDocument with a bare "404.php" — Apache treats
# that as a response message string, not a document path.

# ==================================================

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [L]
